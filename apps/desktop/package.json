{
  "name": "@zidiankaifa/desktop",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --publish never",
    "test": "node test/dbmigrate.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@zidiankaifa/core": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.zidiankaifa.dict",
    "productName": "我的电子辞典",
    "directories": {
      "output": "../../dist-release"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      {
        "from": "../web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../../data/db/dict.db",
        "to": "dict/dict.db",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "zidiankaifa-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "我的电子辞典"
    },
    "portable": {
      "artifactName": "zidiankaifa-portable-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lzk101",
        "repo": "zidiankaifa"
      }
    ]
  }
}

