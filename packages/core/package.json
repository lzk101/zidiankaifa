    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node test/regress.mjs && node test/lexicon.mjs && node test/related.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}


